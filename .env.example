# Environment variables for Neighborhood Golf Carts Shop Board
#
# Copy to Vercel → Project → Settings → Environment Variables
# (Production). Do not commit real keys.

# Required for live Housecall Pro job sync (7:00 AM America/Chicago).
# Admin → My Apps → API Key Management. Prefer read-only.
HOUSECALL_PRO_API_KEY=

# Optional alias for HOUSECALL_PRO_API_KEY
# HCP_API_KEY=

# Optional. Default is Token <key>. Set to "bearer" if your key uses Bearer.
# HOUSECALL_PRO_AUTH_SCHEME=token

# Optional multi-location company id
# HOUSECALL_PRO_COMPANY_ID=

# Optional override (default https://api.housecallpro.com)
# HOUSECALL_PRO_API_URL=

# Optional. HMAC secret from Housecall Pro → My Apps → Webhooks.
# Inventory still updates from the scheduled poll when this is unset.
# The webhook URL is https://ngc-shop-board.vercel.app/api/webhooks/housecall-pro
# HOUSECALL_PRO_WEBHOOK_SECRET=

# Optional. Days of newly completed jobs the first inventory poll reads.
# Default 1. Maximum 90. A larger number deducts those jobs on the first run.
# INVENTORY_USAGE_LOOKBACK_DAYS=1

# Recommended. Vercel sends Authorization: Bearer $CRON_SECRET to cron routes.
CRON_SECRET=

# Required for shared shop-board storage (phone + computer).
# Vercel → Storage → Create Database → Blob → connect to ngc-shop-board.
# The dashboard injects this token on Production / Preview.
BLOB_READ_WRITE_TOKEN=

# Required for the Parts process write API (POST / DELETE /api/parts).
# Generate a long random string. Set it on the Vercel project (Production + Preview).
# Never commit the real value. Board reads (GET /api/parts) stay open like /api/board.
# Shop-floor PUT /api/parts stays open (no token) so /parts can save real edits.
PARTS_WRITE_TOKEN=
